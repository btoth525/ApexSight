# ---- ApexSight push relay configuration -------------------------------------
# Copy to ".env" and fill in. NEVER commit your real .env.

# Password for the admin web GUI (pick something long).
APEX_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Non-secret defaults (already public — they ship in the app). Edit only if you
# rebuilt the app under a different identity.
APEX_TEAM_ID=3Q9ZUDN4QZ
APEX_BUNDLE_ID=com.brandontoth.apexsight.native

# Optional: pin the session-cookie secret (otherwise generated + stored in /data).
# APEX_SECRET_KEY=

# Max /v1 API calls accepted per client IP per minute.
APEX_RATE_LIMIT=120

# ---- Cloudflare Tunnel ------------------------------------------------------
# Token from: Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → Install.
CLOUDFLARE_TUNNEL_TOKEN=

# NOTE: Your APNs .p8 key, Key ID, and Team ID are uploaded through the web GUI
# (/admin/settings) and stored in the /data volume — NOT in this file.
