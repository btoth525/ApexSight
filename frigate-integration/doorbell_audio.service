[Unit]
Description=Aqara G410 two-way audio WebSocket proxy
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/config/scripts
ExecStart=/usr/bin/python3 /config/scripts/doorbell_audio_ws.py
Restart=always
RestartSec=5

# Set these to match your setup
Environment=DOORBELL_IP=192.168.1.67
Environment=WS_PORT=8556
# Paste your Frigate JWT token below (same one shown in Apex Settings)
Environment=FRIGATE_TOKEN=YOUR_FRIGATE_JWT_TOKEN_HERE

[Install]
WantedBy=multi-user.target
