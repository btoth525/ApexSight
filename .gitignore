# macOS / Xcode
.DS_Store
native-ios/*.xcodeproj
native-ios/DerivedData/
native-ios/build/
*.xcuserstate
xcuserdata/

# Python (push relay / HA add-on / Frigate integration)
__pycache__/
*.pyc
.venv/
venv/
*.sqlite
*.db

# Secrets — never commit signing keys or certs
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.jks
.env

# Build outputs and vendored trees — none of this belongs in the repo, and together it is
# ~736 MB sitting one `git add -A` away from being committed. CLAUDE.md warns "never git add -A"
# precisely because these were unignored; that warning is a workaround for this file's gaps.
node_modules/
.expo/
# Expo-generated native project — regenerated by `expo prebuild`, 276 MB.
/ios/
# Local ship artifacts: .xcarchive bundles, ship*.sh / ship*.log, scratch scripts.
native-ios/scratchpad/
# NESTED GIT REPO (btoth525/apexsight-ha-addon). Committing it would add a gitlink pointing at a
# commit this repo can't resolve — it is cloned here for convenience, not vendored.
native-ios/apexsight-ha-addon/

# Misc
*.orig.*
.claude/worktrees/
# Stray coordinate dump from the simulator tap tooling.
native-ios/tap
