{
  "expo": {
    "name": "Apex",
    "slug": "apex-frigate",
    "version": "2.0.2",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "package": "com.brandontoth.apexsight"
    },
    "ios": {
      "bundleIdentifier": "com.brandontoth.apexsight",
      "buildNumber": "5",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used for live camera viewing",
        "NSMicrophoneUsageDescription": "Used for live camera audio",
        "UIBackgroundModes": ["voip", "audio"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "@config-plugins/react-native-callkeep",
      "./plugins/withApexDoorbell.js"
    ],
    "scheme": "apex",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "da9915a4-4e63-40ba-a722-d57fcf07b251"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "btoth525"
  }
}
