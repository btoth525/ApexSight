{
  "expo": {
    "name": "Apex",
    "slug": "apex-frigate",
    "version": "2.0.2",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "package": "com.brandontoth.apexsight"
    },
    "ios": {
      "bundleIdentifier": "com.brandontoth.apexsight",
      "buildNumber": "5",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Apex uses camera access only when a live WebRTC view requests it.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock your saved Frigate sign-in.",
        "NSLocalNetworkUsageDescription": "Apex connects to your local Frigate server on your home network.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-font"
    ],
    "scheme": "apex",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "da9915a4-4e63-40ba-a722-d57fcf07b251"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "btoth525"
  }
}
